      "@id": "schema:description"
    },
    "destination": {
      "@id": "calm:destination_end"
    },
    "detailed-architecture": {
      "@id": "calm:detailed_architecture"
    },
    "details": {
      "@id": "calm:details"
    },
    "direction": {
      "@id": "calm:direction"
    },
    "evidence": {
      "@id": "calm:evidence"
    },
    "evidence-paths": {
      "@id": "calm:evidence_paths"
    },
    "flows": {
      "@id": "calm:flows"
    },
