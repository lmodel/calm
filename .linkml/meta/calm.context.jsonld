    },
    "protocol": {
      "@id": "calm:protocol"
    },
    "rate": {
      "@id": "calm:rate",
      "@type": "xsd:float"
    },
    "relationship-type": {
      "@id": "calm:relationship_type"
    },
    "relationship-unique-id": {
      "@id": "calm:relationship_unique_id"
