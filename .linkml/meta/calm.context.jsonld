    },
    "interfaces": {
      "@id": "calm:interfaces"
    },
    "metadata": {
      "@id": "calm:metadata",
      "@type": "@json"
    },
    "moments": {
      "@id": "calm:moments"
    },
    "name": {
      "@id": "schema:name"
    },
    "node": {
      "@id": "calm:node"
    },
