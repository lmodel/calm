	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/calm/CalmTransition> ;
	linkml:required true .
<https://w3id.org/lmodel/calm/unique_id> a linkml:SlotDefinition ;
	skos:prefLabel "unique-id" ;
	linkml:description "CALM unique-id for future linking and uniquely defining this evidence" , "The interface's identifier, unique within the architecture." , "The node's identifier, unique within the architecture." , "The relationship's identifier, unique within the architecture." , "Unique identifier for the flow" , "Unique identifier for this decorator" , "Unique identifier for this interface instance" ;
	linkml:required true .
<https://w3id.org/lmodel/calm/unit_of_time> a linkml:SlotDefinition ;
	skos:altLabel "unit" ;
	linkml:description "The unit of time (e.g., seconds, minutes, hours)." ;
