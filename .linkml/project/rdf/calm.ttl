<https://w3id.org/lmodel/calm/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/calm/calm> dcterms:license "Apache-2.0" ;
	dcterms:source "https://github.com/finos/calm-schema/tree/47e2a41a0e1e5e9fe639b30ce2adae8c4abc5b6d/schema"^^xsd:anyURI ;
	dcterms:title "FINOS CALM" ;
	pav:version "1.3" ;
	schema1:keywords "CALM" , "FINOS" , "architecture as code" , "software architecture" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://calm.finos.org/"^^xsd:anyURI , "https://github.com/finos/calm-schema"^^xsd:anyURI , "https://lmodel.github.io/calm"^^xsd:anyURI ;
	skos:note "A reference to a node, relationship or moment is its unique-id, a string, as CALM gives it. No slot is an identifier: gen-python in linkml 1.12.1 names an identifier's type from its alias, and the hyphen in unique-id makes that name invalid Python." , "A slot whose name differs from CALM's key carries the key as its alias, such as unique_id for unique-id. scripts/calm_meta.py writes CALM's files with the aliases as keys, which plain gen-json-schema does only with --preserve-names." , "Six slots list CALM's key under aliases instead, so that only CALM's files carry it. Five are source_end, destination_end, target_architectures, unit_of_time and decorator_type, because LOKF defines source, target, unit and type with other meanings, and a composite's JSON-LD context gives each key one IRI. The sixth, decorator_schema, holds $schema, which gen-python would make an attribute's name." , "calm.json and calm-timeline.json declare CALM's vocabulary beside JSON Schema's own and hold no definition, so no module renders them; the build copies them from upstream/." ;
	sh:declare _:c14n28 , _:c14n46 , _:c14n70 , _:c14n90 ;
	linkml:annotations _:c14n23 , _:c14n54 , _:c14n60 , _:c14n62 ;
	linkml:classes <https://w3id.org/lmodel/calm/CalmArchitecture> , <https://w3id.org/lmodel/calm/CalmComposedOfType> , <https://w3id.org/lmodel/calm/CalmConnectsType> , <https://w3id.org/lmodel/calm/CalmControl> , <https://w3id.org/lmodel/calm/CalmControlConfig> , <https://w3id.org/lmodel/calm/CalmControlDetail> , <https://w3id.org/lmodel/calm/CalmControlRequirement> , <https://w3id.org/lmodel/calm/CalmControls> , <https://w3id.org/lmodel/calm/CalmDecision> , <https://w3id.org/lmodel/calm/CalmDecorator> , <https://w3id.org/lmodel/calm/CalmDecoratorData> , <https://w3id.org/lmodel/calm/CalmDeployedInType> , <https://w3id.org/lmodel/calm/CalmEvidence> , <https://w3id.org/lmodel/calm/CalmEvidenceDocument> , <https://w3id.org/lmodel/calm/CalmFlow> , <https://w3id.org/lmodel/calm/CalmInteractsType> , <https://w3id.org/lmodel/calm/CalmInterfaceConfig> , <https://w3id.org/lmodel/calm/CalmInterfaceDefinition> , <https://w3id.org/lmodel/calm/CalmInterfaceType> , <https://w3id.org/lmodel/calm/CalmMetadata> , <https://w3id.org/lmodel/calm/CalmNode> , <https://w3id.org/lmodel/calm/CalmNodeDetails> , <https://w3id.org/lmodel/calm/CalmNodeInterface> , <https://w3id.org/lmodel/calm/CalmNodeMoment> , <https://w3id.org/lmodel/calm/CalmRateUnit> , <https://w3id.org/lmodel/calm/CalmRelationship> , <https://w3id.org/lmodel/calm/CalmRelationshipType> , <https://w3id.org/lmodel/calm/CalmTimeUnit> , <https://w3id.org/lmodel/calm/CalmTimeline> , <https://w3id.org/lmodel/calm/CalmTransition> ;
	linkml:default_prefix "calm" ;
	linkml:default_range <https://w3id.org/lmodel/calm/string> ;
	linkml:description "A LinkML model of CALM 1.3, the Common Architecture Language Model of FINOS's Architecture as Code project. Each module renders one file of the CALM Meta Schema and keeps CALM's keys, so a CALM document validates here unchanged, and CALM's JSON Schema files can be generated from the model." ;
	linkml:enums <https://w3id.org/lmodel/calm/CalmDecoratorTargetType> , <https://w3id.org/lmodel/calm/CalmNodeTypeDefinition> , <https://w3id.org/lmodel/calm/CalmProtocol> , <https://w3id.org/lmodel/calm/CalmRateInterval> , <https://w3id.org/lmodel/calm/CalmTimeUnitName> , <https://w3id.org/lmodel/calm/CalmTransitionDirection> ;
	linkml:id "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
