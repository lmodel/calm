<https://w3id.org/lmodel/calm/CalmCronExpression> dcterms:title "Cron Expression" ;
	a linkml:TypeDefinition ;
	skos:exactMatch "calm_meta:units.json#/defs/cron-expression"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/calm/calm_units"^^xsd:anyURI ;
	skos:note "CALM's pattern accepts only numbers, so it refuses all three of CALM's own examples, each of which holds an asterisk. The build copies the examples as CALM gives them, and tests/test_parity.py records the fault." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/calm/CalmCronExpression"^^xsd:anyURI ;
	linkml:description "A valid Unix-style cron expression." ;
	linkml:examples _:c14n3 , _:c14n64 , _:c14n83 ;
	linkml:pattern "^([0-5]?\\d)\\s([01]?\\d|2[0-3])\\s(3[01]|[12]\\d|0?[1-9])\\s(1[0-2]|0?[1-9])\\s([0-6])$" ;
	linkml:typeof <https://w3id.org/lmodel/calm/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
