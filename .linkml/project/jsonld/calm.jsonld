  "slots": [
    {
      "name": "calmArchitecture__nodes",
      "description": "The components of the architecture.",
      "from_schema": "https://w3id.org/lmodel/calm",
      "slot_uri": "https://w3id.org/lmodel/calm/nodes",
      "alias": "nodes",
      "owner": "CalmArchitecture",
      "domain_of": [
        "CalmArchitecture"
      ],
      "range": "CalmNode",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "calmArchitecture__relationships",
