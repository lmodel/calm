      "slot_uri": "https://w3id.org/lmodel/calm/per",
      "alias": "per",
      "owner": "CalmRateUnit",
      "domain_of": [
        "CalmRateUnit"
      ],
      "range": "CalmRateInterval",
      "required": true,
