calm:actor a owl:DatatypeProperty ;
	rdfs:label "actor" ;
	skos:definition "The unique-id of the node that acts." ;
	skos:inScheme calm:calm_core .
calm:adrs a owl:DatatypeProperty .
calm:applies_to a owl:DatatypeProperty ;
	rdfs:label "applies_to" ;
	skos:definition "Array of unique-ids referencing nodes, relationships, flows, or other architecture elements" ;
	skos:inScheme calm:calm_decorators ;
	skos:prefLabel "applies-to" .
calm:composed_of a owl:ObjectProperty ;
	rdfs:label "composed_of" ;
	skos:definition "Nodes that make up a container node." ;
	skos:inScheme calm:calm_core ;
	skos:prefLabel "composed-of" .
calm:config a owl:ObjectProperty .
calm:config_url a owl:DatatypeProperty ;
	rdfs:label "config_url" ;
	skos:definition "The configuration of how the control requirement schema is met" ;
	skos:inScheme calm:calm_control ;
	skos:prefLabel "config-url" .
calm:connects a owl:ObjectProperty ;
	rdfs:label "connects" ;
	skos:definition "A connection from one node's interfaces to another's." ;
	skos:inScheme calm:calm_core .
calm:container a owl:DatatypeProperty .
calm:control_config_url a owl:DatatypeProperty ;
	rdfs:label "control_config_url" ;
	skos:definition "URI for the control configuration this evidence relates to" ;
	skos:inScheme calm:calm_evidence ;
	skos:prefLabel "control-config-url" .
calm:control_id a owl:DatatypeProperty ;
	rdfs:label "control_id" ;
	skos:definition "The unique identifier of this control, which has the potential to be used for linking evidence" ;
	skos:inScheme calm:calm_control_requirement ;
	skos:prefLabel "control-id" .
calm:controls a owl:DatatypeProperty , owl:ObjectProperty .
calm:current_moment a owl:DatatypeProperty ;
	rdfs:label "current_moment" ;
	skos:definition "The unique-id of the current architecture moment within the timeline." ;
	skos:inScheme calm:calm_timeline ;
	skos:prefLabel "current-moment" .
calm:data a owl:ObjectProperty ;
	rdfs:label "data" ;
	skos:definition "Free-form JSON object containing the decorator's data" ;
	skos:inScheme calm:calm_decorators .
calm:decorator_schema a owl:DatatypeProperty ;
	rdfs:label "decorator_schema" ;
	skos:altLabel "$schema" ;
	skos:definition "URI of the schema that this decorator conforms to, for example a decorator standard" ;
	skos:inScheme calm:calm_decorators ;
	skos:note "CALM's key is $schema, listed under aliases rather than as the alias, because gen-python makes an alias the attribute's name and $schema is no Python name. scripts/calm_meta.py writes the key as $schema." .
calm:decorator_type a owl:DatatypeProperty ;
	rdfs:label "decorator_type" ;
	skos:definition "Type of decorator - a free-form string identifying the decorator category" ;
	skos:inScheme calm:calm_decorators ;
	skos:prefLabel "type" .
calm:definition_url a owl:DatatypeProperty ;
	rdfs:label "definition_url" ;
	skos:definition "URI of the external schema this interface configuration conforms to" ;
	skos:inScheme calm:calm_interface ;
	skos:prefLabel "definition-url" .
calm:deployed_in a owl:ObjectProperty ;
	rdfs:label "deployed_in" ;
	skos:definition "Nodes deployed in a container node." ;
	skos:inScheme calm:calm_core ;
	skos:prefLabel "deployed-in" .
calm:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "A description of a control and how it applies to a given architecture" , "A more detailed description of the control and information on what a developer needs to consider" , "Detailed description of the flow's purpose" , "Functional summary of what is happening in the transition" , "What choosing this option means." , "What the node is and does." , "What the relationship is for." ;
	skos:inScheme calm:calm_control , calm:calm_control_requirement , calm:calm_core , calm:calm_flow .
calm:destination a owl:ObjectProperty ;
	rdfs:label "destination" ;
	skos:definition "The end the connection reaches." ;
	skos:inScheme calm:calm_core .
calm:detailed_architecture a owl:DatatypeProperty ;
	rdfs:label "detailed_architecture" ;
	skos:definition "The address of an architecture document that describes this node in detail." ;
	skos:inScheme calm:calm_core ;
	skos:prefLabel "detailed-architecture" .
calm:details a owl:ObjectProperty ;
	rdfs:label "details" ;
	skos:definition "Where a more detailed architecture of this node is, and the pattern it must follow." ;
	skos:inScheme calm:calm_core .
calm:direction a owl:ObjectProperty ;
	rdfs:label "direction" ;
	skos:definition "Which way along the relationship the step goes." ;
	skos:inScheme calm:calm_flow .
calm:evidence a owl:ObjectProperty ;
	rdfs:label "evidence" ;
	skos:definition "The evidence this document holds." ;
	skos:inScheme calm:calm_evidence .
calm:evidence_paths a owl:DatatypeProperty ;
	rdfs:label "evidence_paths" ;
	skos:definition "Paths to the evidence relating to a specific control" ;
	skos:inScheme calm:calm_evidence ;
	skos:prefLabel "evidence-paths" .
calm:flows a owl:ObjectProperty ;
	rdfs:label "flows" ;
	skos:definition "The business flows that run across the architecture." ;
	skos:inScheme <https://w3id.org/lmodel/calm> .
calm:interacts a owl:ObjectProperty ;
	rdfs:label "interacts" ;
	skos:definition "An actor that interacts with nodes." ;
	skos:inScheme calm:calm_core .
calm:interfaces a owl:DatatypeProperty .
calm:metadata a owl:ObjectProperty .
calm:moments a owl:ObjectProperty ;
	rdfs:label "moments" ;
	skos:definition "A list of significant architecture states or points in time, each represented as a 'moment'." ;
	skos:inScheme calm:calm_timeline .
calm:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	skos:definition "Descriptive name for the business flow" , "The name of the control requirement that provides contextual meaning within a given domain" , "The node's name." ;
	skos:inScheme calm:calm_control_requirement , calm:calm_core , calm:calm_flow .
calm:node a owl:DatatypeProperty ;
	rdfs:label "node" ;
	skos:definition "The unique-id of the node at this end." ;
	skos:inScheme calm:calm_interface .
calm:node_type a owl:DatatypeProperty ;
	rdfs:label "node_type" ;
	skos:definition "What kind of node this is, one of CALM's built-in types or any other name." ;
	skos:inScheme calm:calm_core ;
	skos:prefLabel "node-type" .
calm:nodes a owl:DatatypeProperty , owl:ObjectProperty .
calm:options a owl:ObjectProperty ;
	rdfs:label "options" ;
	skos:definition "Decisions between options, each naming the nodes and relationships it would add." ;
	skos:inScheme calm:calm_core .
calm:per a owl:ObjectProperty ;
	rdfs:label "per" ;
	skos:definition "The time unit defining the rate interval." ;
	skos:inScheme calm:calm_units .
calm:protocol a owl:ObjectProperty ;
	rdfs:label "protocol" ;
	skos:definition "The protocol a connection uses." ;
	skos:inScheme calm:calm_core .
calm:rate a owl:DatatypeProperty ;
	rdfs:label "rate" ;
	skos:definition "The numeric value representing the rate." ;
	skos:inScheme calm:calm_units .
calm:relationship_type a owl:ObjectProperty ;
	rdfs:label "relationship_type" ;
	skos:definition "The kind of the relationship and the nodes it links." ;
	skos:inScheme calm:calm_core ;
	skos:prefLabel "relationship-type" .
calm:relationship_unique_id a owl:DatatypeProperty ;
	rdfs:label "relationship_unique_id" ;
	skos:definition "Unique identifier for the relationship in the architecture" ;
	skos:inScheme calm:calm_flow ;
	skos:prefLabel "relationship-unique-id" .
calm:relationships a owl:DatatypeProperty , owl:ObjectProperty .
calm:required_pattern a owl:DatatypeProperty ;
	rdfs:label "required_pattern" ;
	skos:definition "The address of a pattern that the detailed architecture must follow." ;
	skos:inScheme calm:calm_core ;
	skos:prefLabel "required-pattern" .
calm:requirement_url a owl:DatatypeProperty .
calm:requirements a owl:ObjectProperty ;
	rdfs:label "requirements" ;
	skos:definition "The requirements this control applies, each with its configuration." ;
	skos:inScheme calm:calm_control .
calm:sequence_number a owl:DatatypeProperty ;
	rdfs:label "sequence_number" ;
	skos:definition "Indicates the sequence of the relationship in the flow" ;
	skos:inScheme calm:calm_flow ;
	skos:prefLabel "sequence-number" .
calm:source a owl:ObjectProperty ;
	rdfs:label "source" ;
	skos:definition "The end that opens the connection." ;
	skos:inScheme calm:calm_core .
calm:target a owl:DatatypeProperty ;
	rdfs:label "target" ;
	skos:definition "Array of file paths or URLs referencing the CALM architectures this decorator targets" ;
	skos:inScheme calm:calm_decorators .
calm:target_type a owl:ObjectProperty ;
	rdfs:label "target_type" ;
	skos:definition "Optional array of the types of CALM document that this decorator can target. The only type is architecture, because applies-to holds the unique-ids of architecture elements." ;
	skos:inScheme calm:calm_decorators ;
	skos:prefLabel "target-type" .
calm:transitions a owl:ObjectProperty ;
	rdfs:label "transitions" ;
	skos:definition "The steps of the flow, each across one relationship." ;
	skos:inScheme calm:calm_flow .
calm:unique_id a owl:DatatypeProperty .
calm:unit a owl:ObjectProperty ;
	rdfs:label "unit" ;
	skos:definition "The unit of time (e.g., seconds, minutes, hours)." ;
	skos:inScheme calm:calm_units .
calm:valid_from a owl:DatatypeProperty ;
	rdfs:label "valid_from" ;
	skos:definition "The date when this architecture moment came into effect." ;
	skos:inScheme calm:calm_timeline ;
	skos:prefLabel "valid-from" .
calm:value a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "The numeric value representing the amount of time." ;
	skos:inScheme calm:calm_units .
