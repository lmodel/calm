@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix calm_meta: <https://calm.finos.org/release/1.3/meta/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix calm: <https://w3id.org/lmodel/calm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix schema1: <http://schema.org/> .
<https://w3id.org/lmodel/calm.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/finos/calm-schema/tree/47e2a41a0e1e5e9fe639b30ce2adae8c4abc5b6d/schema> ;
	dcterms:title "FINOS CALM" ;
	pav:version "1.3" ;
	schema1:keywords "CALM" , "FINOS" , "architecture as code" , "software architecture" ;
	a owl:Ontology ;
	rdfs:label "calm" ;
	rdfs:seeAlso <https://calm.finos.org/> , <https://github.com/finos/calm-schema> , <https://lmodel.github.io/calm> ;
	skos:definition "A LinkML model of CALM 1.3, the Common Architecture Language Model of FINOS's Architecture as Code project. Each module renders one file of the CALM Meta Schema and keeps CALM's keys, so a CALM document validates here unchanged, and CALM's JSON Schema files can be generated from the model." ;
	skos:note "A key with a hyphen, such as unique-id, is the alias of a slot named with an underscore. scripts/calm_meta.py writes CALM's files with the aliases as keys, which plain gen-json-schema does only with --preserve-names." , "A reference to a node, relationship or moment is its unique-id, a string, as CALM gives it. No slot is an identifier: gen-python in linkml 1.12.1 names an identifier's type from its alias, and the hyphen in unique-id makes that name invalid Python." , "calm.json and calm-timeline.json declare CALM's vocabulary beside JSON Schema's own and hold no definition, so no module renders them; the build copies them from upstream/." ;
	calm:upstream_commit "47e2a41a0e1e5e9fe639b30ce2adae8c4abc5b6d" ;
	calm:upstream_license "Apache-2.0" ;
	calm:upstream_release_date "2026-10-24" ;
	calm:upstream_tag "v1.3" .
calm:CalmArchitecture a owl:Class ;
	rdfs:label "CalmArchitecture" ;
	rdfs:subClassOf _:c14n125 , _:c14n139 , _:c14n179 , _:c14n229 , _:c14n235 , _:c14n24 , _:c14n246 , _:c14n255 , _:c14n275 , _:c14n286 , _:c14n39 , _:c14n5 , _:c14n55 , _:c14n56 ;
	skos:definition "A CALM architecture document: the nodes of a system, the relationships between them, its business flows, and the controls that apply to it." ;
	skos:exactMatch calm_meta:core.json ;
	skos:inScheme <https://w3id.org/lmodel/calm> ;
	skos:note "An architecture is itself a JSON Schema document, so it may carry JSON Schema's keys, such as $schema, beside CALM's own." .
calm:CalmComposedOfType a owl:Class ;
	rdfs:label "CalmComposedOfType" ;
	rdfs:subClassOf _:c14n1 , _:c14n155 , _:c14n210 , _:c14n276 , _:c14n299 ;
	skos:definition "A relationship in which nodes make up a container node." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/composed-of-type ;
	skos:inScheme calm:calm_core .
calm:CalmConnectsType a owl:Class ;
	rdfs:label "CalmConnectsType" ;
	rdfs:subClassOf _:c14n106 , _:c14n133 , _:c14n18 , _:c14n188 , _:c14n217 , _:c14n35 ;
	skos:definition "A relationship in which one node connects to another through their interfaces." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/connects-type ;
	skos:inScheme calm:calm_core .
calm:CalmControl a owl:Class ;
	rdfs:label "CalmControl" ;
	rdfs:subClassOf _:c14n112 , _:c14n135 , _:c14n172 , _:c14n47 , _:c14n88 ;
	skos:definition "One control in a controls map, with the requirements that define it." ;
	skos:inScheme calm:calm_control .
calm:CalmControlConfig a owl:Class ;
	rdfs:label "CalmControlConfig" ;
	skos:definition "A configuration object, free in shape, that meets a control requirement." ;
	skos:inScheme calm:calm_control .
calm:CalmControlDetail a owl:Class ;
	rdfs:label "CalmControlDetail" ;
	rdfs:subClassOf _:c14n122 , _:c14n146 , _:c14n158 , _:c14n193 , _:c14n200 , _:c14n207 , _:c14n23 , _:c14n259 , _:c14n292 ;
	owl:disjointUnionOf _:c14n300 ;
	skos:definition "A control requirement this control applies, with its configuration given by address or inline, but not both." ;
	skos:exactMatch calm_meta:control.json\#\/defs\/control-detail ;
	skos:inScheme calm:calm_control .
calm:CalmControlRequirement a owl:Class ;
	rdfs:label "CalmControlRequirement" ;
	rdfs:subClassOf _:c14n132 , _:c14n144 , _:c14n15 , _:c14n199 , _:c14n205 , _:c14n223 , _:c14n272 , _:c14n42 , _:c14n68 ;
	skos:definition "A control requirement: what a control must achieve, which a control detail's requirement-url points to." ;
	skos:exactMatch calm_meta:control-requirement.json ;
	skos:inScheme calm:calm_control_requirement .
calm:CalmControls a owl:Class ;
	rdfs:label "CalmControls" ;
	skos:definition "The controls that apply to an architecture element, each under a key of letters, digits and hyphens." ;
	skos:exactMatch calm_meta:control.json\#\/defs\/controls ;
	skos:inScheme calm:calm_control ;
	skos:note "CALM states the key pattern with patternProperties, which LinkML cannot state, so any key is accepted here. CALM itself leaves a key outside the pattern unchecked." .
calm:CalmCronExpression a rdfs:Datatype ;
	owl:equivalentClass _:c14n37 .
calm:CalmDecision a owl:Class ;
	rdfs:label "CalmDecision" ;
	rdfs:subClassOf _:c14n153 , _:c14n187 , _:c14n225 , _:c14n248 , _:c14n271 , _:c14n285 , _:c14n288 , _:c14n33 , _:c14n72 ;
	skos:definition "One option of a choice, naming the nodes, relationships and controls it would add." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/decision ;
	skos:inScheme calm:calm_core .
calm:CalmDecorator a owl:Class ;
	rdfs:label "CalmDecorator" ;
	rdfs:subClassOf _:c14n101 , _:c14n121 , _:c14n159 , _:c14n160 , _:c14n163 , _:c14n174 , _:c14n178 , _:c14n189 , _:c14n194 , _:c14n2 , _:c14n251 , _:c14n258 , _:c14n3 , _:c14n30 , _:c14n59 , _:c14n6 , _:c14n60 , _:c14n81 ;
	skos:definition "Supplementary information about elements of one or more architectures, kept apart from the architectures themselves." ;
	skos:exactMatch calm_meta:decorators.json\#\/defs\/decorator ;
	skos:inScheme calm:calm_decorators .
calm:CalmDecoratorData a owl:Class ;
	rdfs:label "CalmDecoratorData" ;
	skos:definition "The decorator's data, an object free in shape." ;
	skos:inScheme calm:calm_decorators ;
	skos:note "CALM requires at least one key, which LinkML cannot state, so an empty object is accepted here." .
calm:CalmDecoratorTargetType\#architecture a owl:Class ;
	rdfs:label "architecture" ;
	rdfs:subClassOf calm:CalmDecoratorTargetType ;
	skos:definition "An architecture document." .
calm:CalmDecoratorTargetType a owl:Class ;
	rdfs:label "CalmDecoratorTargetType" ;
	skos:definition "The kinds of CALM document a decorator can target." ;
	skos:inScheme calm:calm_decorators ;
	linkml:permissible_values calm:CalmDecoratorTargetType\#architecture .
calm:CalmDeployedInType a owl:Class ;
	rdfs:label "CalmDeployedInType" ;
	rdfs:subClassOf _:c14n247 , _:c14n283 , _:c14n61 , _:c14n77 , _:c14n83 ;
	skos:definition "A relationship in which nodes are deployed in a container node." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/deployed-in-type ;
	skos:inScheme calm:calm_core .
calm:CalmEvidence a owl:Class ;
	rdfs:label "CalmEvidence" ;
	rdfs:subClassOf _:c14n108 , _:c14n145 , _:c14n175 , _:c14n182 , _:c14n220 , _:c14n38 , _:c14n58 , _:c14n63 ;
	skos:definition "Evidence that a control's configuration is met, by the paths where it is kept." ;
	skos:inScheme calm:calm_evidence .
calm:CalmEvidenceDocument a owl:Class ;
	rdfs:label "CalmEvidenceDocument" ;
	rdfs:subClassOf _:c14n156 , _:c14n165 , _:c14n265 ;
	skos:definition "An evidence document, which holds one piece of evidence for a control." ;
	skos:exactMatch calm_meta:evidence.json ;
	skos:inScheme calm:calm_evidence .
calm:CalmFlow a owl:Class ;
	rdfs:label "CalmFlow" ;
	rdfs:subClassOf _:c14n138 , _:c14n141 , _:c14n147 , _:c14n164 , _:c14n206 , _:c14n21 , _:c14n213 , _:c14n233 , _:c14n244 , _:c14n252 , _:c14n253 , _:c14n254 , _:c14n260 , _:c14n270 , _:c14n289 , _:c14n293 , _:c14n296 , _:c14n301 , _:c14n66 , _:c14n8 ;
	skos:definition "A business flow, as an ordered list of transitions across the architecture's relationships." ;
	skos:exactMatch calm_meta:flow.json\#\/defs\/flow ;
	skos:inScheme calm:calm_flow .
calm:CalmInteractsType a owl:Class ;
	rdfs:label "CalmInteractsType" ;
	rdfs:subClassOf _:c14n100 , _:c14n162 , _:c14n27 , _:c14n64 , _:c14n69 ;
	skos:definition "A relationship in which an actor interacts with nodes." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/interacts-type ;
	skos:inScheme calm:calm_core .
calm:CalmInterfaceConfig a owl:Class ;
	rdfs:label "CalmInterfaceConfig" ;
	skos:definition "A configuration object, free in shape, that an interface definition's schema checks." ;
	skos:inScheme calm:calm_interface .
calm:CalmInterfaceDefinition a owl:Class ;
	rdfs:label "CalmInterfaceDefinition" ;
	rdfs:subClassOf _:c14n117 , _:c14n126 , _:c14n13 , _:c14n142 , _:c14n171 , _:c14n212 , _:c14n228 , _:c14n234 , _:c14n298 ;
	skos:definition "A modular interface definition referencing an external schema" ;
	skos:exactMatch calm_meta:interface.json\#\/defs\/interface-definition ;
	skos:inScheme calm:calm_interface .
calm:CalmInterfaceType a owl:Class ;
	rdfs:label "CalmInterfaceType" ;
	rdfs:subClassOf _:c14n16 , _:c14n268 , _:c14n98 ;
	skos:definition "An interface given by its own keys, such as a host and port, rather than by an external schema." ;
	skos:exactMatch calm_meta:interface.json\#\/defs\/interface-type ;
	skos:inScheme calm:calm_interface .
calm:CalmMetadata a owl:Class ;
	rdfs:label "CalmMetadata" ;
	skos:definition "Free-form metadata, as an object or a list of objects." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/metadata , linkml:Any ;
	skos:inScheme calm:calm_core ;
	skos:note "LinkML cannot state \"an object, or a list of objects\", so the class takes any value, and the build writes it as a schema that accepts any value." .
calm:CalmNode a owl:Class ;
	rdfs:label "CalmNode" ;
	rdfs:subClassOf _:c14n10 , _:c14n104 , _:c14n109 , _:c14n116 , _:c14n118 , _:c14n127 , _:c14n129 , _:c14n131 , _:c14n157 , _:c14n161 , _:c14n177 , _:c14n181 , _:c14n186 , _:c14n19 , _:c14n218 , _:c14n273 , _:c14n282 , _:c14n54 , _:c14n79 , _:c14n85 , _:c14n93 , _:c14n97 , _:c14n99 ;
	skos:definition "A component of the architecture, such as a system, service, database or actor, with its interfaces and controls." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/node ;
	skos:inScheme calm:calm_core .
calm:CalmNodeDetails a owl:Class ;
	rdfs:label "CalmNodeDetails" ;
	rdfs:subClassOf _:c14n152 , _:c14n168 , _:c14n185 , _:c14n192 , _:c14n267 , _:c14n75 ;
	skos:definition "References from a node to a more detailed architecture and to the pattern it must follow." ;
	skos:inScheme calm:calm_core .
calm:CalmNodeInterface a owl:Class ;
	rdfs:label "CalmNodeInterface" ;
	rdfs:subClassOf _:c14n134 , _:c14n140 , _:c14n26 , _:c14n53 , _:c14n62 ;
	skos:definition "One end of a connection, naming a node and, optionally, which of its interfaces." ;
	skos:exactMatch calm_meta:interface.json\#\/defs\/node-interface ;
	skos:inScheme calm:calm_interface .
calm:CalmNodeMoment a owl:Class ;
	rdfs:label "CalmNodeMoment" ;
	rdfs:subClassOf calm:CalmNode , _:c14n202 , _:c14n236 , _:c14n243 , _:c14n46 , _:c14n71 , _:c14n73 ;
	skos:definition "A moment of a timeline: a node of type moment, with no interfaces, whose details point to the architecture of that moment." ;
	skos:exactMatch calm_meta:timeline.json\#\/defs\/node-moment ;
	skos:inScheme calm:calm_timeline ;
	skos:note "The three conditions on inherited slots are class rules, not slot_usage, because gen-shacl refuses equals_string on a slot that also has any_of." .
calm:CalmNodeTypeDefinition\#actor a owl:Class ;
	rdfs:label "actor" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A person or system outside the architecture that acts on it." .
calm:CalmNodeTypeDefinition\#data-asset dcterms:title "data asset" ;
	a owl:Class ;
	rdfs:label "data-asset" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A body of data the architecture holds or moves." .
calm:CalmNodeTypeDefinition\#database a owl:Class ;
	rdfs:label "database" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A store of data." .
calm:CalmNodeTypeDefinition\#ecosystem a owl:Class ;
	rdfs:label "ecosystem" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A group of systems that work together." .
calm:CalmNodeTypeDefinition\#ldap a owl:Class ;
	rdfs:label "ldap" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A directory service reached over LDAP." .
calm:CalmNodeTypeDefinition\#network a owl:Class ;
	rdfs:label "network" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A network that nodes are deployed in." .
calm:CalmNodeTypeDefinition\#service a owl:Class ;
	rdfs:label "service" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A service that runs in the architecture." .
calm:CalmNodeTypeDefinition\#system a owl:Class ;
	rdfs:label "system" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A system made of other nodes." .
calm:CalmNodeTypeDefinition\#webclient a owl:Class ;
	rdfs:label "webclient" ;
	rdfs:subClassOf calm:CalmNodeTypeDefinition ;
	skos:definition "A client that runs in a web browser." .
calm:CalmNodeTypeDefinition a owl:Class ;
	rdfs:label "CalmNodeTypeDefinition" ;
	owl:unionOf _:c14n92 ;
	skos:definition "CALM's built-in node types. A node may also name a type of its own, so the build publishes this list open to any other string." ;
	skos:exactMatch calm_meta:core.json\#\/defs\/node-type-definition ;
	skos:inScheme calm:calm_core ;
	linkml:permissible_values calm:CalmNodeTypeDefinition\#actor , calm:CalmNodeTypeDefinition\#data-asset , calm:CalmNodeTypeDefinition\#database , calm:CalmNodeTypeDefinition\#ecosystem , calm:CalmNodeTypeDefinition\#ldap , calm:CalmNodeTypeDefinition\#network , calm:CalmNodeTypeDefinition\#service , calm:CalmNodeTypeDefinition\#system , calm:CalmNodeTypeDefinition\#webclient .
