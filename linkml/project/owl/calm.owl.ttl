<https://w3id.org/lmodel/calm/node-type/webclient> a owl:Class ;
    rdfs:label "webclient" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A webclient node." .

calm:options a owl:ObjectProperty ;
    rdfs:label "options" ;
    rdfs:range calm:Decision ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

<https://w3id.org/lmodel/calm/protocol/AMQP> a owl:Class ;
    rdfs:label "AMQP" ;
    rdfs:subClassOf calm:Protocol ;
    skos:definition "The AMQP protocol." .

<https://w3id.org/lmodel/calm/protocol/FTP> a owl:Class ;
    rdfs:label "FTP" ;
    rdfs:subClassOf calm:Protocol ;
    skos:definition "The FTP protocol." .

<https://w3id.org/lmodel/calm/protocol/HTTP> a owl:Class ;
    rdfs:label "HTTP" ;
    rdfs:subClassOf calm:Protocol ;
    skos:definition "The HTTP protocol." .

<https://w3id.org/lmodel/calm/protocol/HTTPS> a owl:Class ;
    rdfs:label "HTTPS" ;
    rdfs:subClassOf calm:Protocol ;
    skos:definition "The HTTPS protocol." .

<https://w3id.org/lmodel/calm/protocol/JDBC> a owl:Class ;
    rdfs:label "JDBC" ;
    rdfs:subClassOf calm:Protocol ;
    skos:definition "The JDBC protocol." .

<https://w3id.org/lmodel/calm/protocol/LDAP> a owl:Class ;
