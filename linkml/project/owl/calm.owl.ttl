@prefix attack: <https://w3id.org/lmodel/attack/> .
@prefix calm: <https://w3id.org/lmodel/calm/> .
@prefix capec: <https://w3id.org/lmodel/capec/> .
@prefix cis_controls: <https://w3id.org/lmodel/cis-controls/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/lmodel/dpv/> .
@prefix finos_calm: <https://calm.finos.org/release/1.2/meta/> .
@prefix fluxnova_bpmn_platform: <https://w3id.org/lmodel/fluxnova-bpm-platform/> .
@prefix gist: <https://w3id.org/lmodel/gist/> .
@prefix iso27001: <https://w3id.org/lmodel/iso27001/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nist_csf_v2: <https://w3id.org/lmodel/nist-csf-v2/> .
@prefix nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/> .
@prefix ocsf: <https://w3id.org/lmodel/ocsf/> .
@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stix: <https://w3id.org/lmodel/stix/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/calm.owl.ttl> a owl:Ontology ;
    rdfs:label "calm" ;
    dct:license "Apache-2.0" ;
    dct:source finos_calm:calm.json ;
    dct:title "Common Architecture Language Model (CALM)" ;
    pav:version "1.2" ;
    rdfs:seeAlso <https://calm.finos.org/>,
        <https://github.com/finos/architecture-as-code> ;
    skos:definition "LinkML representation of the FINOS Common Architecture Language Model (CALM) 1.2 specification. CALM is a declarative, JSON-based modeling language for describing complex software architectures (nodes, relationships, controls, flows, decorators, timelines, evidence, and units). This LinkML schema is generated from the CALM JSON-Schema meta files." .

calm:OptionList a owl:Class ;
    rdfs:label "OptionList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:decisions ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Decision ;
            owl:onProperty calm:decisions ] ;
    skos:definition "Wrapper around the list of ``Decision`` alternatives in an options relationship." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:control_config_url a owl:DatatypeProperty ;
    rdfs:label "control_config_url" ;
    rdfs:range xsd:string ;
    skos:altLabel "control-config-url" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:evidence_paths a owl:DatatypeProperty ;
    rdfs:label "evidence_paths" ;
    rdfs:range xsd:string ;
    skos:altLabel "evidence-paths" ;
    skos:definition "Paths (filesystem or URL) pointing at supporting evidence." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:Architecture a owl:Class ;
    rdfs:label "Architecture" ;
    dct:title "Common Architecture Language Model (CALM) Vocab" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:adrs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Relationship ;
            owl:onProperty calm:relationships ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:relationships ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Control ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Node ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:adrs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:flows ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Flow ;
            owl:onProperty calm:flows ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:nodes ] ;
    skos:closeMatch schema1:SoftwareApplication,
        gist:System ;
    skos:definition "Top-level CALM architecture document." ;
    skos:exactMatch calm:Architecture ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch capec:Category,
        cis_controls:CISControlsDocument,
        dpv:Context,
        iso27001:InformationSecurityManagementSystem,
        nist_csf_v2:CSFDocument,
        nist_sp_800_53:Catalog,
        oscal:SystemSecurityPlan,
        stix:Bundle .

calm:ControlDetail a owl:Class ;
    rdfs:label "ControlDetail" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:config_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:config_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:config ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:config_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:requirement_url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:requirement_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:config ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:requirement_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:config ] ;
    skos:closeMatch dpv:TechnicalMeasure,
        oscal:SspImplementedRequirement ;
    skos:definition "A single control requirement and its inline / referenced configuration." ;
    skos:exactMatch calm:ControlDetail ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch nist_sp_800_53:ControlGroup .

calm:ControlRequirement a owl:Class ;
    rdfs:label "ControlRequirement" ;
    dct:title "Common Architecture Language Model Control Requirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:control_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:control_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:control_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:description ] ;
    skos:closeMatch cis_controls:CISControl,
        dpv:OrganisationalMeasure,
        iso27001:SecurityControl,
        nist_csf_v2:CSFCategory,
        oscal:Control ;
    skos:definition "Domain-defined control requirement that controls can reference." ;
    skos:exactMatch calm:ControlRequirement ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch attack:Technique,
        capec:View,
        nist_sp_800_53:ControlEnhancement .

calm:Decorator a owl:Class ;
    rdfs:label "Decorator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:target ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:data ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:data ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:target ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:data ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:applies_to ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:applies_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:type ] ;
    skos:definition "Cross-cutting annotation attached to nodes, relationships, or flows." ;
    skos:exactMatch calm:Decorator ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch iso27001:MonitoringItem,
        nist_csf_v2:Link,
        stix:ExtensionDefinition .

calm:EvidenceDocument a owl:Class ;
    rdfs:label "EvidenceDocument" ;
    dct:title "Common Architecture Language Model Evidence" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:evidence ] ;
    skos:closeMatch iso27001:DocumentedInformation,
        ocsf:Evidences,
        oscal:AssessmentResults ;
    skos:definition "Top-level CALM evidence document linking control configurations to evidence artefacts." ;
    skos:exactMatch calm:EvidenceDocument ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch dpv:LegalMeasure .

calm:InterfaceType a owl:Class ;
    rdfs:label "InterfaceType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:unique_id ] ;
    skos:definition "Inline (free-form) interface definition keyed by unique-id." ;
    skos:exactMatch calm:InterfaceType ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:NodeMoment a owl:Class ;
    rdfs:label "NodeMoment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:details ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:details ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:adrs ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( calm:NodeType xsd:string ) ] calm:NodeType ) ] ;
            owl:onProperty calm:node_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:InterfaceDefinition ;
            owl:onProperty calm:interfaces ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:details ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:node_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:adrs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:valid_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:valid_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty calm:valid_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:interfaces ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:node_type ],
        calm:Node ;
    skos:definition "An architecture moment - a point-in-time snapshot of the architecture." ;
    skos:exactMatch calm:NodeMoment ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch fluxnova_bpmn_platform:EndEvent,
        fluxnova_bpmn_platform:FlowNode .

calm:RateUnit a owl:Class ;
    rdfs:label "RateUnit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:rate ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:RatePerUnit ;
            owl:onProperty calm:per ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:per ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:rate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty calm:rate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:per ] ;
    skos:definition "A rate (count per time unit), e.g. operations per second." ;
    skos:exactMatch calm:RateUnit ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:TimeUnit a owl:Class ;
    rdfs:label "TimeUnit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:TimeUnitName ;
            owl:onProperty calm:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty calm:value ] ;
    skos:definition "A quantity of time expressed as a numeric value and a unit." ;
    skos:exactMatch schema1:Duration,
        calm:TimeUnit ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:Timeline a owl:Class ;
    rdfs:label "Timeline" ;
    dct:title "Common Architecture Language Model (CALM) Timelines Vocab" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:current_moment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:current_moment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:current_moment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:moments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:moments ] ;
    skos:definition "CALM timeline document capturing architecture moments over time." ;
    skos:exactMatch calm:Timeline ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch fluxnova_bpmn_platform:Process,
        gist:TemporalRelation,
        iso27001:ManagementReview,
        oscal:AssessmentResultsDocument .

<https://w3id.org/lmodel/calm/RatePerUnit#day> a owl:Class ;
    rdfs:label "day" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per day." .

<https://w3id.org/lmodel/calm/RatePerUnit#hour> a owl:Class ;
    rdfs:label "hour" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per hour." .

<https://w3id.org/lmodel/calm/RatePerUnit#microsecond> a owl:Class ;
    rdfs:label "microsecond" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per microsecond." .

<https://w3id.org/lmodel/calm/RatePerUnit#millisecond> a owl:Class ;
    rdfs:label "millisecond" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per millisecond." .

<https://w3id.org/lmodel/calm/RatePerUnit#minute> a owl:Class ;
    rdfs:label "minute" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per minute." .

<https://w3id.org/lmodel/calm/RatePerUnit#month> a owl:Class ;
    rdfs:label "month" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per month." .

<https://w3id.org/lmodel/calm/RatePerUnit#nanosecond> a owl:Class ;
    rdfs:label "nanosecond" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per nanosecond." .

<https://w3id.org/lmodel/calm/RatePerUnit#quarter> a owl:Class ;
    rdfs:label "quarter" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per quarter." .

<https://w3id.org/lmodel/calm/RatePerUnit#second> a owl:Class ;
    rdfs:label "second" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per second." .

<https://w3id.org/lmodel/calm/RatePerUnit#week> a owl:Class ;
    rdfs:label "week" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per week." .

<https://w3id.org/lmodel/calm/RatePerUnit#year> a owl:Class ;
    rdfs:label "year" ;
    rdfs:subClassOf calm:RatePerUnit ;
    skos:definition "Rate denominator: per year." .

<https://w3id.org/lmodel/calm/RelationshipKind#composed_of> a owl:Class ;
    rdfs:label "composed_of" ;
    rdfs:subClassOf calm:RelationshipKind ;
    skos:definition "Composition: nodes composed by a container." .

<https://w3id.org/lmodel/calm/RelationshipKind#connects> a owl:Class ;
    rdfs:label "connects" ;
    rdfs:subClassOf calm:RelationshipKind ;
    skos:definition "Interface-to-interface connection." .

<https://w3id.org/lmodel/calm/RelationshipKind#deployed_in> a owl:Class ;
    rdfs:label "deployed_in" ;
    rdfs:subClassOf calm:RelationshipKind ;
    skos:definition "Containment: nodes deployed in a container." .

<https://w3id.org/lmodel/calm/RelationshipKind#interacts> a owl:Class ;
    rdfs:label "interacts" ;
    rdfs:subClassOf calm:RelationshipKind ;
    skos:definition "Actor-to-nodes interaction." .

<https://w3id.org/lmodel/calm/RelationshipKind#options> a owl:Class ;
    rdfs:label "options" ;
    rdfs:subClassOf calm:RelationshipKind ;
    skos:definition "A set of alternative decisions." .

<https://w3id.org/lmodel/calm/TimeUnitName#days> a owl:Class ;
    rdfs:label "days" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: days." .

<https://w3id.org/lmodel/calm/TimeUnitName#hours> a owl:Class ;
    rdfs:label "hours" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: hours." .

<https://w3id.org/lmodel/calm/TimeUnitName#microseconds> a owl:Class ;
    rdfs:label "microseconds" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: microseconds." .

<https://w3id.org/lmodel/calm/TimeUnitName#milliseconds> a owl:Class ;
    rdfs:label "milliseconds" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: milliseconds." .

<https://w3id.org/lmodel/calm/TimeUnitName#minutes> a owl:Class ;
    rdfs:label "minutes" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: minutes." .

<https://w3id.org/lmodel/calm/TimeUnitName#months> a owl:Class ;
    rdfs:label "months" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: months." .

<https://w3id.org/lmodel/calm/TimeUnitName#nanoseconds> a owl:Class ;
    rdfs:label "nanoseconds" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: nanoseconds." .

<https://w3id.org/lmodel/calm/TimeUnitName#quarters> a owl:Class ;
    rdfs:label "quarters" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: quarters." .

<https://w3id.org/lmodel/calm/TimeUnitName#seconds> a owl:Class ;
    rdfs:label "seconds" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: seconds." .

<https://w3id.org/lmodel/calm/TimeUnitName#weeks> a owl:Class ;
    rdfs:label "weeks" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: weeks." .

<https://w3id.org/lmodel/calm/TimeUnitName#years> a owl:Class ;
    rdfs:label "years" ;
    rdfs:subClassOf calm:TimeUnitName ;
    skos:definition "Time unit: years." .

<https://w3id.org/lmodel/calm/TransitionDirection#destination_to_source> a owl:Class ;
    rdfs:label "destination_to_source" ;
    rdfs:subClassOf calm:TransitionDirection ;
    skos:definition "Flow direction: destination-to-source." .

<https://w3id.org/lmodel/calm/TransitionDirection#source_to_destination> a owl:Class ;
    rdfs:label "source_to_destination" ;
    rdfs:subClassOf calm:TransitionDirection ;
    skos:definition "Flow direction: source-to-destination." .

calm:applies_to a owl:DatatypeProperty ;
    rdfs:label "applies_to" ;
    rdfs:range xsd:string ;
    skos:altLabel "applies-to" ;
    skos:definition "Array of unique-ids referencing nodes, relationships, flows, or other architecture elements" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:decisions a owl:ObjectProperty ;
    rdfs:label "decisions" ;
    rdfs:range calm:Decision ;
    skos:definition "Alternative decisions under an ``options`` relationship." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:flows a owl:ObjectProperty ;
    rdfs:label "flows" ;
    rdfs:range calm:Flow ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:moments a owl:DatatypeProperty ;
    rdfs:label "moments" ;
    rdfs:range xsd:string ;
    skos:definition "A list of significant architecture states or points in time, each represented as a 'moment'." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

<https://w3id.org/lmodel/calm/node-type/actor> a owl:Class ;
    rdfs:label "actor" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A actor node." .

<https://w3id.org/lmodel/calm/node-type/data-asset> a owl:Class ;
    rdfs:label "data_asset" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A data-asset node." .

<https://w3id.org/lmodel/calm/node-type/database> a owl:Class ;
    rdfs:label "database" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A database node." .

<https://w3id.org/lmodel/calm/node-type/ecosystem> a owl:Class ;
    rdfs:label "ecosystem" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A ecosystem node." .

<https://w3id.org/lmodel/calm/node-type/ldap> a owl:Class ;
    rdfs:label "ldap" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A ldap node." .

<https://w3id.org/lmodel/calm/node-type/network> a owl:Class ;
    rdfs:label "network" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A network node." .

<https://w3id.org/lmodel/calm/node-type/service> a owl:Class ;
    rdfs:label "service" ;
    rdfs:subClassOf calm:NodeType ;
    skos:definition "A service node." .

<https://w3id.org/lmodel/calm/node-type/system> a owl:Class ;
    rdfs:label "system" ;
