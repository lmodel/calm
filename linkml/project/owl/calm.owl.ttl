calm:target a owl:DatatypeProperty ;
    rdfs:label "target" ;
    rdfs:range xsd:string ;
    skos:definition "Array of file paths or URLs referencing the CALM documents (patterns, architectures, or controls) this decorator targets" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:transitions a owl:ObjectProperty ;
    rdfs:label "transitions" ;
    rdfs:range calm:Transition ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:ComposedOfRelationship a owl:Class ;
    rdfs:label "ComposedOfRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:container ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Node ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:container ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:container ] ;
    skos:definition "A ``composed-of`` containment relationship." ;
    skos:exactMatch calm:ComposedOfRelationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:ConnectsRelationship a owl:Class ;
    rdfs:label "ConnectsRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:destination ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:NodeInterface ;
            owl:onProperty calm:source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:NodeInterface ;
            owl:onProperty calm:destination ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:destination ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:source ] ;
    skos:definition "A ``connects`` relationship between two node interfaces." ;
    skos:exactMatch calm:ConnectsRelationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:DeployedInRelationship a owl:Class ;
    rdfs:label "DeployedInRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:container ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:container ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:container ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Node ;
            owl:onProperty calm:nodes ] ;
    skos:definition "A ``deployed-in`` containment relationship." ;
    skos:exactMatch calm:DeployedInRelationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:Flow a owl:Class ;
    rdfs:label "Flow" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:requirement_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:requirement_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:requirement_url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:transitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Control ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Transition ;
            owl:onProperty calm:transitions ] ;
    skos:closeMatch fluxnova_bpmn_platform:FlowElement ;
    skos:definition "Business flow mapped onto architecture relationships." ;
    skos:exactMatch calm:Flow ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch attack:Tactic,
        fluxnova_bpmn_platform:SubProcess,
        gist:ServiceSpecification,
        iso27001:OperationalProcedure,
        nist_csf_v2:CSFFunction,
        ocsf:NetworkTraffic,
        oscal:SspControlImplementation .

calm:InteractsRelationship a owl:Class ;
    rdfs:label "InteractsRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:actor ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Node ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:actor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:actor ] ;
    skos:definition "An ``interacts`` relationship between an actor and one or more nodes." ;
    skos:exactMatch calm:InteractsRelationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:RelationshipType a owl:Class ;
    rdfs:label "RelationshipType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:options ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:DeployedInRelationship ;
            owl:onProperty calm:deployed_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:ComposedOfRelationship ;
            owl:onProperty calm:composed_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:ConnectsRelationship ;
            owl:onProperty calm:connects ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:connects ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:InteractsRelationship ;
            owl:onProperty calm:interacts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:composed_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Decision ;
            owl:onProperty calm:options ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:connects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:deployed_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:deployed_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:composed_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:interacts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:interacts ] ;
    skos:definition "Tagged-union container for the variant body of a relationship. Exactly one of ``interacts``, ``connects``, ``deployed_in``, ``composed_of``, ``options`` is populated; see ``RelationshipKind`` for the discriminator values." ;
    skos:exactMatch calm:RelationshipType ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:Transition a owl:Class ;
    rdfs:label "Transition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:TransitionDirection ;
            owl:onProperty calm:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:sequence_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:relationship_unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:sequence_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:relationship_unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:relationship_unique_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty calm:sequence_number ] ;
    skos:closeMatch fluxnova_bpmn_platform:SequenceFlow ;
    skos:definition "A single step in a flow, anchored on a relationship." ;
    skos:exactMatch calm:Transition ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:actor a owl:DatatypeProperty ;
    rdfs:label "actor" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:composed_of a owl:ObjectProperty ;
    rdfs:label "composed_of" ;
    rdfs:range calm:ComposedOfRelationship ;
    skos:altLabel "composed-of" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:config_url a owl:DatatypeProperty ;
    rdfs:label "config_url" ;
    rdfs:range xsd:string ;
    skos:altLabel "config-url" ;
    skos:definition "The configuration of how the control requirement schema is met" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:connects a owl:ObjectProperty ;
    rdfs:label "connects" ;
    rdfs:range calm:ConnectsRelationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:control_id a owl:DatatypeProperty ;
    rdfs:label "control_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "control-id" ;
    skos:definition "The unique identifier of this control, which has the potential to be used for linking evidence" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:current_moment a owl:DatatypeProperty ;
    rdfs:label "current_moment" ;
    rdfs:range xsd:string ;
    skos:altLabel "current-moment" ;
    skos:definition "The unique-id of the current architecture moment within the timeline." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:data a owl:DatatypeProperty ;
    rdfs:label "data" ;
    rdfs:range xsd:string ;
    skos:definition "Free-form JSON object containing the decorator's data" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:definition_url a owl:DatatypeProperty ;
    rdfs:label "definition_url" ;
    rdfs:range xsd:string ;
    skos:altLabel "definition-url" ;
    skos:definition "URI of the external schema this interface configuration conforms to" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:deployed_in a owl:ObjectProperty ;
    rdfs:label "deployed_in" ;
    rdfs:range calm:DeployedInRelationship ;
    skos:altLabel "deployed-in" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:destination a owl:ObjectProperty ;
    rdfs:label "destination" ;
    rdfs:range calm:NodeInterface ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:direction a owl:ObjectProperty ;
    rdfs:label "direction" ;
    rdfs:range calm:TransitionDirection ;
    skos:definition "Direction of flow on the transition." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:evidence a owl:DatatypeProperty ;
    rdfs:label "evidence" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:interacts a owl:ObjectProperty ;
    rdfs:label "interacts" ;
    rdfs:range calm:InteractsRelationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:node a owl:DatatypeProperty ;
    rdfs:label "node" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:per a owl:ObjectProperty ;
    rdfs:label "per" ;
    rdfs:range calm:RatePerUnit ;
    skos:definition "The time unit defining the rate interval." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:protocol a owl:ObjectProperty ;
    rdfs:label "protocol" ;
    rdfs:range calm:Protocol ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:rate a owl:DatatypeProperty ;
    rdfs:label "rate" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "The numeric value representing the rate." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:relationship_type a owl:ObjectProperty ;
    rdfs:label "relationship_type" ;
    rdfs:range calm:RelationshipType ;
    skos:altLabel "relationship-type" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:relationship_unique_id a owl:DatatypeProperty ;
    rdfs:label "relationship_unique_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "relationship-unique-id" ;
    skos:definition "Unique identifier for the relationship in the architecture" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:sequence_number a owl:DatatypeProperty ;
    rdfs:label "sequence_number" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
    skos:altLabel "sequence-number" ;
    skos:definition "Indicates the sequence of the relationship in the flow" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:source a owl:ObjectProperty ;
    rdfs:label "source" ;
    rdfs:range calm:NodeInterface ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of decorator - a free-form string identifying the decorator category" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    rdfs:range calm:TimeUnitName ;
    skos:definition "The unit of time (e.g., seconds, minutes, hours)." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:valid_from a owl:DatatypeProperty ;
    rdfs:label "valid_from" ;
    rdfs:range xsd:date ;
    skos:altLabel "valid-from" ;
    skos:definition "The date when this architecture moment came into effect." ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    calm:json_format "date" .

calm:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "The numeric value representing the amount of time." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:Relationship a owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Protocol ;
            owl:onProperty calm:protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:RelationshipType ;
            owl:onProperty calm:relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Control ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:metadata ] ;
    skos:closeMatch gist:NetworkLink,
        stix:StixRelationshipObject ;
    skos:definition "A typed link between architecture elements." ;
    skos:exactMatch calm:Relationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch prov:wasInfluencedBy,
        attack:AttackRelationship,
        ocsf:NetworkEndpoint .

calm:TransitionDirection a owl:Class ;
    rdfs:label "TransitionDirection" ;
    owl:unionOf ( <https://w3id.org/lmodel/calm/TransitionDirection#source_to_destination> <https://w3id.org/lmodel/calm/TransitionDirection#destination_to_source> ) ;
    skos:definition "Direction of flow on a transition." ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    linkml:permissible_values <https://w3id.org/lmodel/calm/TransitionDirection#destination_to_source>,
        <https://w3id.org/lmodel/calm/TransitionDirection#source_to_destination> .

calm:adrs a owl:DatatypeProperty ;
    rdfs:label "adrs" ;
    rdfs:range xsd:string ;
    skos:definition "External links to ADRs (Architecture Decision Records) or similar documents that provide context or decisions related to the architecture. These can be URLs or references to internal documentation." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:relationships a owl:ObjectProperty ;
    rdfs:label "relationships" ;
    rdfs:range calm:Relationship ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:Decision a owl:Class ;
    rdfs:label "Decision" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom calm:Relationship ;
            owl:onProperty calm:relationships ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Node ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:nodes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:relationships ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Control ;
            owl:onProperty calm:controls ] ;
    skos:definition "A candidate decision within an ``options`` relationship." ;
    skos:exactMatch calm:Decision ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:InterfaceDefinition a owl:Class ;
    rdfs:label "InterfaceDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:config ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:config ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:definition_url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:definition_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:config ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:definition_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:unique_id ] ;
    skos:closeMatch ocsf:NetworkInterface ;
    skos:definition "Modular interface definition referencing an external schema." ;
    skos:exactMatch calm:InterfaceDefinition ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch gist:Network .

calm:NodeInterface a owl:Class ;
    rdfs:label "NodeInterface" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom calm:InterfaceDefinition ;
            owl:onProperty calm:interfaces ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:node ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:interfaces ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:node ] ;
    skos:definition "Reference to one or more interfaces exposed by a node." ;
    skos:exactMatch calm:NodeInterface ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:RelationshipKind a owl:Class ;
    rdfs:label "RelationshipKind" ;
    owl:unionOf ( <https://w3id.org/lmodel/calm/RelationshipKind#interacts> <https://w3id.org/lmodel/calm/RelationshipKind#connects> <https://w3id.org/lmodel/calm/RelationshipKind#deployed_in> <https://w3id.org/lmodel/calm/RelationshipKind#composed_of> <https://w3id.org/lmodel/calm/RelationshipKind#options> ) ;
    skos:definition "Discriminator for the variant of a ``relationship-type``: exactly one of the following keys is set on a relationship's ``relationship-type``." ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    linkml:permissible_values <https://w3id.org/lmodel/calm/RelationshipKind#composed_of>,
        <https://w3id.org/lmodel/calm/RelationshipKind#connects>,
        <https://w3id.org/lmodel/calm/RelationshipKind#deployed_in>,
        <https://w3id.org/lmodel/calm/RelationshipKind#interacts>,
        <https://w3id.org/lmodel/calm/RelationshipKind#options> .

calm:config a owl:DatatypeProperty ;
    rdfs:label "config" ;
    rdfs:range xsd:string ;
    skos:definition "Inline configuration of how the control requirement schema is met" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:container a owl:DatatypeProperty ;
    rdfs:label "container" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:details a owl:DatatypeProperty ;
    rdfs:label "details" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:interfaces a owl:ObjectProperty ;
    rdfs:label "interfaces" ;
    rdfs:range calm:InterfaceDefinition ;
    skos:definition "Interface definitions exposed by nodes." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:node_type a owl:ObjectProperty ;
    rdfs:label "node_type" ;
    rdfs:range [ owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( calm:NodeType xsd:string ) ] calm:NodeType ) ] ;
    skos:altLabel "node-type" ;
    skos:definition "Category of the node (system, service, actor, etc.)." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:requirement_url a owl:DatatypeProperty ;
    rdfs:label "requirement_url" ;
    rdfs:range xsd:string ;
    skos:altLabel "requirement-url" ;
    skos:definition "The requirement schema that specifies how a control should be defined" ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:Control a owl:Class ;
    rdfs:label "Control" ;
    skos:closeMatch attack:Mitigation,
        cis_controls:Safeguard,
        dpv:TechnicalOrganisationalMeasure,
        iso27001:SecurityControl,
        nist_csf_v2:CSFSubcategory,
        nist_sp_800_53:Control,
        ocsf:Compliance,
        oscal:Control ;
    skos:definition "A named control attached to an architecture element." ;
    skos:exactMatch calm:Control ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch schema1:Action,
        capec:Category,
        stix:Core .

calm:Node a owl:Class ;
    rdfs:label "Node" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:details ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:interfaces ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:node_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty calm:details ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:Control ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:controls ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:details ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( calm:NodeType xsd:string ) ] calm:NodeType ) ] ;
            owl:onProperty calm:node_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:node_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty calm:unique_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom calm:InterfaceDefinition ;
            owl:onProperty calm:interfaces ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty calm:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty calm:name ] ;
    skos:broadMatch stix:StixDomainObject ;
    skos:closeMatch schema1:Thing,
        attack:Asset,
        gist:NetworkNode,
        iso27001:Asset,
        ocsf:Actor,
        ocsf:Node ;
    skos:definition "A logical or physical element of an architecture (system, service, actor, ...)." ;
    skos:exactMatch calm:Node ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    skos:relatedMatch capec:AttackPattern,
        cis_controls:Safeguard,
        dpv:DataController,
        oscal:SspInventoryItem .

calm:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Short human-readable name." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:nodes a owl:ObjectProperty ;
    rdfs:label "nodes" ;
    rdfs:range calm:Node ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:RatePerUnit a owl:Class ;
    rdfs:label "RatePerUnit" ;
    owl:unionOf ( <https://w3id.org/lmodel/calm/RatePerUnit#nanosecond> <https://w3id.org/lmodel/calm/RatePerUnit#microsecond> <https://w3id.org/lmodel/calm/RatePerUnit#millisecond> <https://w3id.org/lmodel/calm/RatePerUnit#second> <https://w3id.org/lmodel/calm/RatePerUnit#minute> <https://w3id.org/lmodel/calm/RatePerUnit#hour> <https://w3id.org/lmodel/calm/RatePerUnit#day> <https://w3id.org/lmodel/calm/RatePerUnit#week> <https://w3id.org/lmodel/calm/RatePerUnit#month> <https://w3id.org/lmodel/calm/RatePerUnit#quarter> <https://w3id.org/lmodel/calm/RatePerUnit#year> ) ;
    skos:definition "Time interval denominator used by ``RateUnit``." ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    linkml:permissible_values <https://w3id.org/lmodel/calm/RatePerUnit#day>,
        <https://w3id.org/lmodel/calm/RatePerUnit#hour>,
        <https://w3id.org/lmodel/calm/RatePerUnit#microsecond>,
        <https://w3id.org/lmodel/calm/RatePerUnit#millisecond>,
        <https://w3id.org/lmodel/calm/RatePerUnit#minute>,
        <https://w3id.org/lmodel/calm/RatePerUnit#month>,
        <https://w3id.org/lmodel/calm/RatePerUnit#nanosecond>,
        <https://w3id.org/lmodel/calm/RatePerUnit#quarter>,
        <https://w3id.org/lmodel/calm/RatePerUnit#second>,
        <https://w3id.org/lmodel/calm/RatePerUnit#week>,
        <https://w3id.org/lmodel/calm/RatePerUnit#year> .

calm:TimeUnitName a owl:Class ;
    rdfs:label "TimeUnitName" ;
    owl:unionOf ( <https://w3id.org/lmodel/calm/TimeUnitName#nanoseconds> <https://w3id.org/lmodel/calm/TimeUnitName#microseconds> <https://w3id.org/lmodel/calm/TimeUnitName#milliseconds> <https://w3id.org/lmodel/calm/TimeUnitName#seconds> <https://w3id.org/lmodel/calm/TimeUnitName#minutes> <https://w3id.org/lmodel/calm/TimeUnitName#hours> <https://w3id.org/lmodel/calm/TimeUnitName#days> <https://w3id.org/lmodel/calm/TimeUnitName#weeks> <https://w3id.org/lmodel/calm/TimeUnitName#months> <https://w3id.org/lmodel/calm/TimeUnitName#quarters> <https://w3id.org/lmodel/calm/TimeUnitName#years> ) ;
    skos:definition "Named unit of time used by ``TimeUnit``." ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    linkml:permissible_values <https://w3id.org/lmodel/calm/TimeUnitName#days>,
        <https://w3id.org/lmodel/calm/TimeUnitName#hours>,
        <https://w3id.org/lmodel/calm/TimeUnitName#microseconds>,
        <https://w3id.org/lmodel/calm/TimeUnitName#milliseconds>,
        <https://w3id.org/lmodel/calm/TimeUnitName#minutes>,
        <https://w3id.org/lmodel/calm/TimeUnitName#months>,
        <https://w3id.org/lmodel/calm/TimeUnitName#nanoseconds>,
        <https://w3id.org/lmodel/calm/TimeUnitName#quarters>,
        <https://w3id.org/lmodel/calm/TimeUnitName#seconds>,
        <https://w3id.org/lmodel/calm/TimeUnitName#weeks>,
        <https://w3id.org/lmodel/calm/TimeUnitName#years> .

calm:Protocol a owl:Class ;
    rdfs:label "Protocol" ;
    owl:unionOf ( <https://w3id.org/lmodel/calm/protocol/HTTP> <https://w3id.org/lmodel/calm/protocol/HTTPS> <https://w3id.org/lmodel/calm/protocol/FTP> <https://w3id.org/lmodel/calm/protocol/SFTP> <https://w3id.org/lmodel/calm/protocol/JDBC> <https://w3id.org/lmodel/calm/protocol/WebSocket> <https://w3id.org/lmodel/calm/protocol/SocketIO> <https://w3id.org/lmodel/calm/protocol/LDAP> <https://w3id.org/lmodel/calm/protocol/AMQP> <https://w3id.org/lmodel/calm/protocol/TLS> <https://w3id.org/lmodel/calm/protocol/mTLS> <https://w3id.org/lmodel/calm/protocol/TCP> ) ;
    skos:definition "Wire-level protocol used by a relationship." ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    linkml:permissible_values <https://w3id.org/lmodel/calm/protocol/AMQP>,
        <https://w3id.org/lmodel/calm/protocol/FTP>,
        <https://w3id.org/lmodel/calm/protocol/HTTP>,
        <https://w3id.org/lmodel/calm/protocol/HTTPS>,
        <https://w3id.org/lmodel/calm/protocol/JDBC>,
        <https://w3id.org/lmodel/calm/protocol/LDAP>,
        <https://w3id.org/lmodel/calm/protocol/SFTP>,
        <https://w3id.org/lmodel/calm/protocol/SocketIO>,
        <https://w3id.org/lmodel/calm/protocol/TCP>,
        <https://w3id.org/lmodel/calm/protocol/TLS>,
        <https://w3id.org/lmodel/calm/protocol/WebSocket>,
        <https://w3id.org/lmodel/calm/protocol/mTLS> .

calm:NodeType a owl:Class ;
    rdfs:label "NodeType" ;
    owl:unionOf ( <https://w3id.org/lmodel/calm/node-type/actor> <https://w3id.org/lmodel/calm/node-type/ecosystem> <https://w3id.org/lmodel/calm/node-type/system> <https://w3id.org/lmodel/calm/node-type/service> <https://w3id.org/lmodel/calm/node-type/database> <https://w3id.org/lmodel/calm/node-type/network> <https://w3id.org/lmodel/calm/node-type/ldap> <https://w3id.org/lmodel/calm/node-type/webclient> <https://w3id.org/lmodel/calm/node-type/data-asset> ) ;
    skos:definition "Category of architecture node. The CALM JSON-Schema allows arbitrary strings; this enum lists the canonical values plus an escape hatch via ``any_of`` on the slot." ;
    skos:inScheme <https://w3id.org/lmodel/calm> ;
    linkml:permissible_values <https://w3id.org/lmodel/calm/node-type/actor>,
        <https://w3id.org/lmodel/calm/node-type/data-asset>,
        <https://w3id.org/lmodel/calm/node-type/database>,
        <https://w3id.org/lmodel/calm/node-type/ecosystem>,
        <https://w3id.org/lmodel/calm/node-type/ldap>,
        <https://w3id.org/lmodel/calm/node-type/network>,
        <https://w3id.org/lmodel/calm/node-type/service>,
        <https://w3id.org/lmodel/calm/node-type/system>,
        <https://w3id.org/lmodel/calm/node-type/webclient> .

calm:controls a owl:ObjectProperty ;
    rdfs:label "controls" ;
    rdfs:range calm:Control ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:metadata a owl:DatatypeProperty ;
    rdfs:label "metadata" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Free-form description of the element." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

calm:unique_id a owl:DatatypeProperty ;
    rdfs:label "unique_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "unique-id" ;
    skos:definition "Stable opaque identifier used to cross-link CALM elements." ;
    skos:inScheme <https://w3id.org/lmodel/calm> .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^([0-5]?\\d)\\s([01]?\\d|2[0-3])\\s(3[01]|[12]\\d|0?[1-9])\\s(1[0-2]|0?[1-9])\\s([0-6])$" ] ) ] .


