    linkml:class_uri "https://w3id.org/lmodel/calm/EvidenceDocument"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/EvidenceDocument"^^xsd:anyURI ;
    linkml:description "Top-level CALM evidence document linking control configurations to evidence artefacts." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/calm/evidence> .

<https://w3id.org/lmodel/calm/NodeType> skos:inScheme "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/NodeType"^^xsd:anyURI ;
    linkml:description "Category of architecture node. The CALM JSON-Schema allows arbitrary strings; this enum lists the canonical values plus an escape hatch via ``any_of`` on the slot." ;
    linkml:permissible_values <https://w3id.org/lmodel/calm/actor>,
