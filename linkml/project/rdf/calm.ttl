        "stix:Bundle"^^xsd:anyURI ;
    linkml:class_uri "https://w3id.org/lmodel/calm/Architecture"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/Architecture"^^xsd:anyURI ;
    linkml:description "Top-level CALM architecture document." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/calm/Architecture_flows>,
        <https://w3id.org/lmodel/calm/Architecture_nodes>,
        <https://w3id.org/lmodel/calm/Architecture_relationships>,
        <https://w3id.org/lmodel/calm/adrs>,
        <https://w3id.org/lmodel/calm/controls>,
        <https://w3id.org/lmodel/calm/metadata> ;
    linkml:tree_root true .

<https://w3id.org/lmodel/calm/Decision> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/calm/core> ;
    skos:inScheme "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
    skos:mappingRelation "calm:Decision"^^xsd:anyURI ;
    linkml:class_uri "https://w3id.org/lmodel/calm/Decision"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/Decision"^^xsd:anyURI ;
    linkml:description "A candidate decision within an ``options`` relationship." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/calm/Decision_description>,
        <https://w3id.org/lmodel/calm/Decision_nodes>,
        <https://w3id.org/lmodel/calm/Decision_relationships>,
        <https://w3id.org/lmodel/calm/controls> .

<https://w3id.org/lmodel/calm/NodeMoment> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/calm/timeline> ;
    skos:inScheme "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
    skos:mappingRelation "calm:NodeMoment"^^xsd:anyURI ;
    skos:relatedMatch "fluxnova_bpmn_platform:EndEvent"^^xsd:anyURI,
        "fluxnova_bpmn_platform:FlowNode"^^xsd:anyURI ;
    linkml:class_uri "https://w3id.org/lmodel/calm/NodeMoment"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/NodeMoment"^^xsd:anyURI ;
    linkml:description "An architecture moment - a point-in-time snapshot of the architecture." ;
    linkml:is_a <https://w3id.org/lmodel/calm/Node> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/calm/NodeMoment_details>,
        <https://w3id.org/lmodel/calm/Node_description>,
        <https://w3id.org/lmodel/calm/adrs>,
        <https://w3id.org/lmodel/calm/controls>,
        <https://w3id.org/lmodel/calm/interfaces>,
        <https://w3id.org/lmodel/calm/metadata>,
        <https://w3id.org/lmodel/calm/name>,
        <https://w3id.org/lmodel/calm/node_type>,
        <https://w3id.org/lmodel/calm/unique_id>,
        <https://w3id.org/lmodel/calm/valid_from> .

<https://w3id.org/lmodel/calm/Node> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/calm/core> ;
    skos:broadMatch "stix:StixDomainObject"^^xsd:anyURI ;
    skos:closeMatch "attack:Asset"^^xsd:anyURI,
        "gist:NetworkNode"^^xsd:anyURI,
        "iso27001:Asset"^^xsd:anyURI,
        "ocsf:Actor"^^xsd:anyURI,
        "ocsf:Node"^^xsd:anyURI,
        "schema:Thing"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
    skos:mappingRelation "calm:Node"^^xsd:anyURI ;
    skos:relatedMatch "capec:AttackPattern"^^xsd:anyURI,
        "cis_controls:Safeguard"^^xsd:anyURI,
        "dpv:DataController"^^xsd:anyURI,
        "oscal:SspInventoryItem"^^xsd:anyURI ;
    linkml:class_uri "https://w3id.org/lmodel/calm/Node"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/Node"^^xsd:anyURI ;
    linkml:description "A logical or physical element of an architecture (system, service, actor, ...)." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/calm/Node_description>,
        <https://w3id.org/lmodel/calm/Node_interfaces>,
        <https://w3id.org/lmodel/calm/controls>,
        <https://w3id.org/lmodel/calm/details>,
        <https://w3id.org/lmodel/calm/metadata>,
        <https://w3id.org/lmodel/calm/name>,
        <https://w3id.org/lmodel/calm/node_type>,
        <https://w3id.org/lmodel/calm/unique_id> .

<https://w3id.org/lmodel/calm/string> a linkml:TypeDefinition ;
    skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
    skos:exactMatch "schema:Text"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/String"^^xsd:anyURI ;
    linkml:description "A character string" ;
    linkml:imported_from "linkml:types" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

