<https://w3id.org/lmodel/calm/Metadata> a linkml:TypeDefinition ;
    skos:inScheme "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/Metadata"^^xsd:anyURI ;
    linkml:description "Opaque key/value metadata payload. JSON-Schema allows either an object or an array of objects; in LinkML this is modeled as a permissive string type that downstream consumers parse as JSON." ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

<https://w3id.org/lmodel/calm/unique_id> a linkml:SlotDefinition ;
