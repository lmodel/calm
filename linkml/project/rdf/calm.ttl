<https://w3id.org/lmodel/calm/CronExpression> a linkml:TypeDefinition ;
    skos:inScheme "https://w3id.org/lmodel/calm"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/lmodel/calm/CronExpression"^^xsd:anyURI ;
    linkml:description "A Unix-style cron expression (minute, hour, day, month, weekday)." ;
    linkml:pattern "^([0-5]?\\d)\\s([01]?\\d|2[0-3])\\s(3[01]|[12]\\d|0?[1-9])\\s(1[0-2]|0?[1-9])\\s([0-6])$" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

